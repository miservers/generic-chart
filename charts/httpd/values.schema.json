{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "appName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "fullnameOverride": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "image": {
      "type": "string",
      "minLength": 1
    },
    "replicas": {
      "type": "integer",
      "minimum": 1
    },
    "port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "proxyTimeout": {
      "type": "integer",
      "minimum": 1
    },
    "clusterDomain": {
      "type": "string",
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
    },
    "backend": {
      "type": "object",
      "required": [
        "serviceName",
        "namespace",
        "port"
      ],
      "properties": {
        "serviceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "route": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
        }
      }
    },
    "stickySession": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "cookieName": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "statefulSetName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "headlessServiceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "replicas": {
          "type": "integer",
          "minimum": 2,
          "maximum": 100
        },
        "podPort": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "healthCheckPath": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9/_~.-]*$"
        },
        "healthCheckInterval": {
          "type": "integer",
          "minimum": 1
        },
        "retrySeconds": {
          "type": "integer",
          "minimum": 1
        },
        "connectionTimeout": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
