{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "appName",
    "namespaces",
    "frontend",
    "backend",
    "route"
  ],
  "properties": {
    "appName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "clusterDomain": {
      "type": "string",
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
    },
    "namespaces": {
      "type": "object",
      "required": [
        "frontend",
        "backend"
      ],
      "properties": {
        "frontend": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "backend": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        }
      }
    },
    "route": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string",
          "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
        }
      }
    },
    "frontend": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "proxyTimeout": {
          "type": "integer",
          "minimum": 1
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "backend": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "servicePort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
